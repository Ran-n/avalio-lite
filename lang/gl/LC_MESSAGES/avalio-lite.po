msgstr "Aparencia"

msgid "Average: the mean of the marked tests"
msgstr "Media: a media das probas cualificadas"

msgid "Change PIN"
msgstr "Cambiar o PIN"

msgid "Class average {}"
msgstr "Media da clase {}"

msgid "Close"
msgstr "Pechar"

msgid "Counts on top of the 100%"
msgstr "Conta ademais do 100 %"

msgid "Current PIN"
msgstr "PIN actual"

