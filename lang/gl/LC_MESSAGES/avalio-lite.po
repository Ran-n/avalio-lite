msgstr "Repite o PIN"

msgid "Rounded: another column rounded to whole marks or decimals"
msgstr "Redondeo: outra columna redondeada a enteiros ou a decimais"

msgid "Rounds"
msgstr "Redondea"

msgid "Test: a mark out of a maximum that counts towards the final grade"
msgstr "Proba: unha nota sobre un máximo que conta para a nota final"

