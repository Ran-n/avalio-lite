import { Theme } from "../theme.slint";
import { ActionButton, ButtonKind } from "../components/buttons.slint";
import { Card } from "../components/surfaces.slint";

// Light or dark.
export component AppearanceCard inherits Card {
    callback choose-theme(bool);

    title: @tr("Appearance");
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        ActionButton {
            text: @tr("Light");
            kind: Theme.dark ? ButtonKind.secondary : ButtonKind.primary;
            clicked => { root.choose-theme(false); }
        }
        ActionButton {
            text: @tr("Dark");
            kind: Theme.dark ? ButtonKind.primary : ButtonKind.secondary;
            clicked => { root.choose-theme(true); }
        }
    }
}
