import { Theme } from "theme.slint";
import { ActionButton, ButtonKind, IconButton } from "components/buttons.slint";
import { Update, UpdateBanner } from "update.slint";

// "avalio lite 0.11.0 is available. · Update and restart · Skip this version ×", or while it
// downloads "Downloading avalio lite 0.11.0… 42 % · Cancel": a strip across the top of the window,
// above the sidebar and every page, like the notification bar of other desktop programs.
export component UpdateBar inherits Rectangle {
    background: Theme.accent-soft;
    VerticalLayout {
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 8px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 8px;
            Text {
                text: Update.banner-text;
                vertical-alignment: center;
                color: Theme.text;
                font-weight: 600;
            }
            if Update.banner == UpdateBanner.offer: ActionButton {
                text: @tr("Update and restart");
                kind: ButtonKind.primary;
                clicked => { Update.install(); }
            }
            if Update.banner == UpdateBanner.offer: ActionButton {
                text: @tr("Skip this version");
                kind: ButtonKind.ghost;
                clicked => { Update.skip(); }
            }
            if Update.banner == UpdateBanner.downloading: ActionButton {
                text: @tr("Cancel");
                // the Settings card has a Cancel for the same download
                spoken-label: @tr("Cancel the update");
                clicked => { Update.cancel(); }
            }
            // the close button sits at the far right, as on other programs' bars
            Rectangle {
                horizontal-stretch: 1;
            }
            // centred on the row like the buttons beside it; a download is stopped with Cancel
            if Update.banner == UpdateBanner.offer: VerticalLayout {
                alignment: center;
                IconButton {
                    glyph: "×";
                    tooltip: @tr("Hide");
                    clicked => { Update.dismiss(); }
                }
            }
        }
        // the line that parts the bar from the window below it
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
    }
}
