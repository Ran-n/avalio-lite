import { Theme } from "theme.slint";
import { ActionButton, ButtonKind, IconButton } from "components/buttons.slint";
import { Update } from "update.slint";

// "avalio-lite 0.6.0 is available · What's new · Update now ×": a strip across the top of the
// window, above the sidebar and every page, like the notification bar of other desktop programs;
// apart from the status line, which every action clears.
export component UpdateBar inherits Rectangle {
    background: Theme.accent-soft;
    VerticalLayout {
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 8px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 8px;
            Text {
                text: Update.notice;
                vertical-alignment: center;
                color: Theme.text;
                font-weight: 600;
            }
            ActionButton {
                text: @tr("What's new");
                kind: ButtonKind.ghost;
                clicked => { Update.whats-new(); }
            }
            ActionButton {
                text: Update.busy ? @tr("Downloading the update…") : @tr("Update now");
                kind: ButtonKind.primary;
                enabled: !Update.busy;
                clicked => { Update.update-now(); }
            }
            // the close button sits at the far right, as on other programs' bars
            Rectangle {
                horizontal-stretch: 1;
            }
            // centred on the row like the buttons beside it
            VerticalLayout {
                alignment: center;
                IconButton {
                    glyph: "×";
                    tooltip: @tr("Hide");
                    enabled: !Update.busy;
                    clicked => { Update.hide(); }
                }
            }
        }
        // the line that parts the bar from the window below it
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
    }
}
