import { Palette } from "std-widgets.slint";
import { SetupNotice, SetupPage } from "setup-page.slint";
import { Section, Shell } from "shell.slint";
import { LockPage } from "lock/lock-page.slint";
import { AddablePupil, CellItem, ClassItem, ColumnItem, ColumnType, DuplicateContents, Gradebook, RowItem, Tone } from "gradebook.slint";
import { Theme } from "theme.slint";
import { ShortcutAction, ShortcutItem, Shortcuts } from "shortcuts.slint";
import { Backup } from "backup.slint";

export { SetupNotice, Section, AddablePupil, CellItem, ClassItem, ColumnItem, ColumnType, DuplicateContents, Gradebook, RowItem, Tone, Theme }
export { ShortcutAction, ShortcutItem, Shortcuts, Backup }

export component AppWindow inherits Window {
    in property <bool> setup-required: true;
    in property <SetupNotice> setup-notice;
    in property <string> setup-notice-detail;
    in-out property <string> setup-database-folder;
    in-out property <string> setup-log-folder;
    in property <string> database-path;
    in property <string> log-folder;
    // the message of the last action; the page that is open shows it, and leaving the page drops it
    in-out property <string> error-message;
    in-out property <string> status-message;
    in property <string> language-code: "en";

    in property <bool> locked;
    // the main area's page; the window switches it for the Settings and class shortcuts
    in-out property <Section> section: Section.sheet;
    in property <bool> pin-set;
    in-out property <string> unlock-pin;
    in property <string> unlock-error;
    in-out property <string> pin-current;
    in-out property <string> pin-new;
    in-out property <string> pin-repeat;

    callback browse-setup-database-folder();
    callback browse-setup-log-folder();
    callback create-database();
    callback open-existing-database();
    callback move-database();
    callback move-logs();
    callback switch-database();
    callback choose-language(string);
    callback choose-theme(bool);
    callback lock-now();
    callback unlock(string);
    callback forgot-pin();
    callback back-to-lock();
    callback set-pin();
    callback change-pin();
    callback remove-pin();

    /// Whether Windows is set to dark mode; used until the user picks a theme.
    public pure function system-prefers-dark() -> bool {
        return Palette.color-scheme == ColorScheme.dark;
    }

    /// Switches every colour, the standard widgets included.
    public function apply-theme(dark: bool) {
        Theme.dark = dark;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    title: "avalio-lite";
    // Windows draws the title bar and taskbar itself, so they always get the light variant
    icon: @image-url("../assets/logo.svg");
    background: Theme.canvas;
    default-font-family: "Segoe UI";
    default-font-size: 15px;
    // the minimum size; src/app/placement.rs lowers it on a screen too small for it (and keeps
    // these numbers and the preferred size in its constants)
    in property <length> fit-min-width: 1000px;
    in property <length> fit-min-height: 600px;
    min-width: root.fit-min-width;
    min-height: root.fit-min-height;
    preferred-width: 1280px;
    preferred-height: 800px;

    // The keyboard shortcuts (Ctrl+L to lock and the others; see shortcuts.slint) work anywhere on
    // the main screen, even while typing in a cell: the key is caught before the focused field sees
    // it. On the first-run and lock screens they do nothing and the key goes on to the field, so a
    // PIN is never hijacked. Keys only arrive while something inside has focus, so the scope takes
    // it back whenever the focused field goes away (unlocking, finishing setup, changing page);
    // the lock screen's PIN field keeps the focus it takes when it appears.
    changed locked => {
        if (root.locked) {
            Shortcuts.recording = -1;
        } else {
            shortcuts.focus();
        }
    }
    // leaving Settings ends a recording; starting one takes the keyboard, wherever it was
    changed section => {
        if (root.section != Section.settings) {
            Shortcuts.recording = -1;
            if (Backup.pin-needed) {
                Backup.pin-cancelled();
            }
        }
    }
    property <int> recording: Shortcuts.recording;
    changed recording => {
        if (root.recording >= 0) {
            shortcuts.focus();
        }
    }
    changed setup-required => {
        if (!root.setup-required && !root.locked) {
            shortcuts.focus();
        }
    }

    shortcuts := FocusScope {
        capture-key-pressed(event) => {
            if (root.setup-required || root.locked) {
                return reject;
            }
            // recording a new shortcut in Settings: every key goes to the recorder, none to a field
            if (Shortcuts.recording >= 0) {
                if (event.text == Key.Escape) {
                    Shortcuts.recording = -1;
                } else if (!(event.text == Key.Control || event.text == Key.ControlR || event.text == Key.Shift
                        || event.text == Key.ShiftR || event.text == Key.Alt || event.text == Key.AltGr
                        || event.text == Key.Meta || event.text == Key.MetaR)) {
                    // a modifier alone waits for the actual key
                    Shortcuts.record(Shortcuts.recording, event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
                }
                return accept;
            }
            let action =Shortcuts.find(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
            if (action == ShortcutAction.none) {
                return reject;
            }
            if (action == ShortcutAction.lock) {
                root.lock-now();
            } else if (action == ShortcutAction.toggle-theme) {
                root.choose-theme(!Theme.dark);
            } else if (action == ShortcutAction.toggle-column-settings) {
                Gradebook.toggle-column-settings();
            } else if (action == ShortcutAction.toggle-sidebar) {
                Gradebook.toggle-sidebar();
            } else if (action == ShortcutAction.open-settings) {
                root.error-message = "";
                root.status-message = "";
                root.section = root.section == Section.settings ? Section.sheet : Section.settings;
            } else {
                root.error-message = "";
                root.status-message = "";
                root.section = Section.sheet;
                Gradebook.select-adjacent-class(action == ShortcutAction.next-class ? 1 : -1);
            }
            return accept;
        }

        if root.setup-required: SetupPage {
            notice: root.setup-notice;
            notice-detail: root.setup-notice-detail;
            error-message: root.error-message;
            database-folder <=> root.setup-database-folder;
            log-folder <=> root.setup-log-folder;
            browse-database-folder => { root.browse-setup-database-folder(); }
            browse-log-folder => { root.browse-setup-log-folder(); }
            create-database => { root.create-database(); }
            open-existing-database => { root.open-existing-database(); }
            back-to-lock => { root.back-to-lock(); }
        }
        if !root.setup-required && !root.locked: Shell {
            section <=> root.section;
            database-path: root.database-path;
            log-folder: root.log-folder;
            error-message <=> root.error-message;
            status-message <=> root.status-message;
            language-code: root.language-code;
            pin-set: root.pin-set;
            pin-current <=> root.pin-current;
            pin-new <=> root.pin-new;
            pin-repeat <=> root.pin-repeat;
            move-database => { root.move-database(); }
            move-logs => { root.move-logs(); }
            switch-database => { root.switch-database(); }
            choose-language(code) => { root.choose-language(code); }
            choose-theme(dark) => { root.choose-theme(dark); }
            lock-now => { root.lock-now(); }
            navigated => { shortcuts.focus(); }
            set-pin => { root.set-pin(); }
            change-pin => { root.change-pin(); }
            remove-pin => { root.remove-pin(); }
        }
        if !root.setup-required && root.locked: LockPage {
            pin <=> root.unlock-pin;
            error-message: root.unlock-error;
            unlock(pin) => { root.unlock(pin); }
            erase => { root.unlock-pin = root.unlock-pin == "" ? "" : root.erase-last(root.unlock-pin); }
            forgot-pin => { root.forgot-pin(); }
        }
    }

    callback erase-last(string) -> string;
}
