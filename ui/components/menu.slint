// The pop-up menu and its entries.

import { Theme } from "../theme.slint";
import { FocusRing } from "focus.slint";

// Floating surface for menus and pickers.
export component MenuSurface inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: Theme.shadow;
    @children
}

export component MenuOption inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <bool> destructive;
    // the option the keyboard is on
    in property <bool> active;
    callback clicked();

    // at least one comfortable row, and as tall as a hint that wraps to more lines needs
    min-height: root.hint == "" ? 40px : 56px;
    border-radius: Theme.radius-s;
    background: root.active || touch.has-hover ? (root.destructive ? Theme.fail-soft : Theme.raised) : transparent;
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.hint;
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        alignment: center;
        spacing: 2px;
        Text { text: root.title; font-weight: 600; color: root.destructive ? Theme.fail : Theme.text; }
        if root.hint != "": Text { text: root.hint; font-size: Theme.text-s; color: Theme.muted; wrap: word-wrap; }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    accessible-action-default => { root.clicked(); }
    if root.active: FocusRing { border-radius: root.border-radius; }
}

export struct MenuEntry {
    // what `chosen` reports; stays the same when other entries come and go
    id: int,
    title: string,
    hint: string,
    destructive: bool,
}

// The options of a popup menu, driven from the keyboard: `focus-first` takes the focus for the
// first option when the popup opens, the arrow keys move between options, Enter or Space picks
// one and Escape dismisses the menu. A click picks too. One focus holder for the whole menu, so
// the options are plain rows.
export component Menu inherits FocusScope {
    in property <[MenuEntry]> entries;
    callback chosen(int);
    callback dismissed();
    property <int> active: 0;

    // a popup's content is made each time it opens, so the keyboard starts on the first option
    init => { root.focus-first(); }

    public function focus-first() {
        root.active = 0;
        root.focus();
    }

    key-pressed(event) => {
        if (event.text == Key.Escape) {
            root.dismissed();
            return accept;
        }
        if (root.entries.length == 0) {
            return reject;
        }
        if (event.text == Key.DownArrow) {
            root.active = Math.mod(root.active + 1, root.entries.length);
        } else if (event.text == Key.UpArrow) {
            root.active = Math.mod(root.active + root.entries.length - 1, root.entries.length);
        } else if (event.text == Key.Home) {
            root.active = 0;
        } else if (event.text == Key.End) {
            root.active = root.entries.length - 1;
        } else if (event.text == Key.Return || event.text == Key.Space) {
            root.chosen(root.entries[root.active].id);
        } else {
            return reject;
        }
        return accept;
    }

    VerticalLayout {
        padding: 6px;
        spacing: 2px;
        for entry[index] in root.entries: MenuOption {
            title: entry.title;
            hint: entry.hint;
            destructive: entry.destructive;
            active: root.has-focus && root.active == index;
            clicked => { root.chosen(entry.id); }
        }
    }
}
