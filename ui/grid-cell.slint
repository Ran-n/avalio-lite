import { Theme } from "theme.slint";
import { Tone } from "gradebook.slint";
import { ScrollingTextInput } from "components/fields.slint";

// One cell of a sheet. Typed cells are borderless until focused; calculated cells
// show their value as a pass / fail pill.
export component GridCell inherits Rectangle {
    in property <string> text;
    in property <bool> invalid;
    in property <bool> computed;
    in property <Tone> tone;
    in property <bool> numeric;
    in property <bool> provisional;
    // "pupil, column", so a screen reader says which cell this is
    in property <string> spoken-label;
    callback edited(string);
    // Enter: the sheet moves on to the cell below
    callback next();
    // while it is being typed in, so the sheet can scroll the whole cell (not only its text) into view
    out property <bool> has-focus: input.has-focus;

    public function focus-and-select() {
        input.focus-text();
        input.select-all();
    }

    public function leave() {
        input.leave();
    }

    height: Theme.row-height;
    background: root.computed ? Theme.computed : root.invalid ? Theme.fail-soft : input.has-focus ? Theme.raised : Theme.surface;

    input := ScrollingTextInput {
        visible: !root.computed;
        // the red shading says "not a valid mark" only to the eye; the label says it to the ear
        spoken-label: root.invalid ? root.spoken-label + " (" + @tr("not a valid mark") + ")" : root.spoken-label;
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        alignment: root.numeric ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        font-size: Theme.text-m;
        text-color: root.invalid ? Theme.fail : root.tone == Tone.fail ? Theme.fail : Theme.text;
        selection-background-color: Theme.accent-soft;
        selection-foreground-color: Theme.text;
        edited(text) => { root.edited(text); }
        accepted => { root.next(); }
    }
    // A calculated cell is one readable item holding its value (and that it is provisional); a typed
    // cell is its own text field. The pill's texts below are drawn only.
    if root.computed: Rectangle {
        accessible-role: AccessibleRole.text;
        accessible-label: root.text == "" ? root.spoken-label
            : root.spoken-label + ": " + root.text + (root.provisional ? " (" + @tr("provisional") + ")" : "");
    }
    // A provisional grade is shown grey with a warning mark instead of pass / fail colours,
    // so it can't be mistaken for a final result while the test weights are wrong.
    if root.computed && root.text != "": Rectangle {
        x: parent.width - self.width - 10px;
        y: (parent.height - self.height) / 2;
        width: pill.preferred-width;
        height: 26px;
        border-radius: 13px;
        border-width: root.provisional ? 1px : 0px;
        border-color: Theme.warn.with-alpha(0.5);
        background: root.provisional ? Theme.raised
            : root.tone == Tone.pass ? Theme.pass-soft
            : root.tone == Tone.fail ? Theme.fail-soft
            : Theme.raised;
        pill := HorizontalLayout {
            padding-left: 11px;
            padding-right: 11px;
            spacing: 5px;
            if root.provisional: Text {
                text: "!";
                accessible-role: AccessibleRole.none;
                font-size: Theme.text-m;
                font-weight: 800;
                vertical-alignment: center;
                color: Theme.warn;
            }
            Text {
                text: root.text;
                accessible-role: AccessibleRole.none;
                font-size: Theme.text-m;
                font-weight: 700;
                vertical-alignment: center;
                color: root.provisional ? Theme.muted
                    : root.tone == Tone.pass ? Theme.pass
                    : root.tone == Tone.fail ? Theme.fail
                    : Theme.text;
            }
        }
    }
    Rectangle {
        border-width: input.has-focus ? 2px : 0px;
        border-color: Theme.accent;
        border-radius: 3px;
    }
}
