import { Theme } from "theme.slint";
import { Gradebook } from "gradebook.slint";
import { NoClassPage } from "sheet/no-class-page.slint";
import { SheetPage } from "sheet/sheet-page.slint";
import { SettingsPage } from "settings/settings-page.slint";
import { Section, Sidebar } from "sidebar.slint";

export { Section } from "sidebar.slint";

export component Shell inherits Rectangle {
    in-out property <Section> section: Section.sheet;
    in property <string> database-path;
    in property <string> log-folder;
    // the message of the last action, shown on whichever page is open and dropped when the page changes
    in-out property <string> error-message;
    in-out property <string> status-message;
    in property <string> language-code;
    in property <bool> pin-set;
    in-out property <string> pin-current;
    in-out property <string> pin-new;
    in-out property <string> pin-repeat;
    callback move-database();
    callback move-logs();
    callback switch-database();
    callback choose-language(string);
    callback choose-theme(bool);
    callback lock-now();
    callback set-pin();
    callback change-pin();
    callback remove-pin();
    // the page changed, so whatever field had focus is gone
    callback navigated();

    changed section => { root.navigated(); }
    background: Theme.canvas;
    HorizontalLayout {
        Sidebar {
            section <=> root.section;
            pin-set: root.pin-set;
            lock-now => { root.lock-now(); }
            toggle-theme => { root.choose-theme(!Theme.dark); }
            navigating => {
                root.error-message = "";
                root.status-message = "";
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            if root.section == Section.sheet && Gradebook.current-class-id >= 0: SheetPage {
                error-message: root.error-message;
                status-message: root.status-message;
            }
            if root.section == Section.sheet && Gradebook.current-class-id < 0: NoClassPage {
                error-message: root.error-message;
                status-message: root.status-message;
            }
            if root.section == Section.settings: SettingsPage {
                database-path: root.database-path;
                log-folder: root.log-folder;
                error-message: root.error-message;
                status-message: root.status-message;
                language-code: root.language-code;
                pin-set: root.pin-set;
                pin-current <=> root.pin-current;
                pin-new <=> root.pin-new;
                pin-repeat <=> root.pin-repeat;
                move-database => { root.move-database(); }
                move-logs => { root.move-logs(); }
                switch-database => { root.switch-database(); }
                choose-language(code) => { root.choose-language(code); }
                choose-theme(dark) => { root.choose-theme(dark); }
                set-pin => { root.set-pin(); }
                change-pin => { root.change-pin(); }
                remove-pin => { root.remove-pin(); }
            }
        }
    }
}
