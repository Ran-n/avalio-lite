import { Theme } from "../theme.slint";
import { Gradebook } from "../gradebook.slint";
import { ActionButton, IconButton } from "../components/buttons.slint";

// The panel's title, with the buttons to step to the previous or next column and to close it.
export component PanelTitle inherits HorizontalLayout {
    in property <string> title;
    in property <bool> is-first;
    in property <bool> is-last;
    callback previous();
    callback next();

    Text {
        text: root.title;
        font-size: Theme.text-l;
        font-weight: 600;
        overflow: elide;
        horizontal-stretch: 1;
        vertical-alignment: center;
        color: Theme.text;
    }
    IconButton {
        glyph: "‹";
        tooltip: @tr("Previous column (Alt+←)");
        enabled: !root.is-first;
        clicked => { root.previous(); }
    }
    IconButton {
        glyph: "›";
        tooltip: @tr("Next column (Alt+→)");
        enabled: !root.is-last;
        clicked => { root.next(); }
    }
    IconButton {
        glyph: "×";
        tooltip: @tr("Close");
        clicked => { Gradebook.close-column-panel(); }
    }
}

// What the weights add up to, under the settings of a test or a final grade.
export component WeightsHint inherits Rectangle {
    background: Theme.raised;
    border-radius: Theme.radius-s;
    hint := Text {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        wrap: word-wrap;
        font-size: Theme.text-s;
        color: Gradebook.weights-complete ? Theme.muted : Theme.warn;
        text: Gradebook.bonus-total == "0"
            ? @tr("The normal tests add up to {}%.", Gradebook.weight-total)
            : @tr("The normal tests add up to {}%. Bonus tests add {}% on top, up to the maximum grade.", Gradebook.weight-total, Gradebook.bonus-total);
    }
    height: hint.preferred-height + 20px;
}

// Moving the column one place left or right; their keys are shown in the faint line below.
export component MoveButtons inherits VerticalLayout {
    in property <bool> is-first;
    in property <bool> is-last;
    callback moved(int);

    spacing: 6px;
    HorizontalLayout {
        spacing: 8px;
        ActionButton {
            horizontal-stretch: 1;
            text: @tr("‹ Move left");
            spoken-label: @tr("Move left (Ctrl+←)");
            enabled: !root.is-first;
            clicked => {
                root.moved(-1);
            }
        }
        ActionButton {
            horizontal-stretch: 1;
            text: @tr("Move right ›");
            spoken-label: @tr("Move right (Ctrl+→)");
            enabled: !root.is-last;
            clicked => {
                root.moved(1);
            }
        }
    }
    Text {
        text: "Ctrl+← / Ctrl+→";
        font-size: Theme.text-s;
        color: Theme.faint;
        horizontal-alignment: center;
    }
}
