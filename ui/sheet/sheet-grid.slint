import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ColumnType, ColumnWidths, Gradebook } from "../gradebook.slint";
import { IconButton } from "../components/buttons.slint";
import { TextField } from "../components/fields.slint";
import { ColumnHeader } from "../column-header.slint";
import { GridCell } from "../grid-cell.slint";
import { NameCell, SurnameCell } from "name-cell.slint";

// The sheet: a card holding the grid of pupils and columns, scrolling when it outgrows the window.
// Every row starts with a fixed strip (a pupil's "×", the add row's "+"); after it come the columns
// in their order, the first-name and surname columns among them.
export component SheetGrid inherits Rectangle {
    // where the column panel's left edge is, in window coordinates; the grid keeps columns left of it
    in property <length> panel-left;
    // the column whose edge is being dragged (-1 for none) and the width it shows meanwhile: only
    // the release saves, so the cells follow the drag through this rather than through the model
    property <int> dragged-column: -1;
    property <length> drag-width;

    // the cell Enter moved to (-1 for none); reset once it has focus, so it can be asked for again
    property <int> focus-row: -1;
    property <int> focus-column: -1;

    // What the add row's fields hold, and requests for them to take the focus: they sit under the
    // name columns wherever those are, so they are reached through these rather than by id. A
    // request stays up until the field takes it, also when the field is made anew (adding a pupil
    // redraws the sheet, columns and all).
    property <string> new-first-name;
    property <string> new-surname;
    property <bool> first-name-wanted: false;
    property <bool> surname-wanted: false;
    property <bool> first-name-focused;
    property <bool> surname-focused;

    // A header being dragged to another place (-1 for none), where the pointer is (in the grid's
    // coordinates), and the gap it would land in: gap g is before column g, gap n after the last.
    // Each header claims the gap at its nearer side while the pointer is over it; past either end
    // of the headers the first or last gap is taken. The line is drawn at `drop-x`.
    property <int> moving-column: -1;
    property <length> move-x;
    property <int> drop-gap: -1;
    property <length> drop-x;
    // the column a drop moved, scrolled into view once the headers are rebuilt
    property <int> moved-column-id: -1;
    // how close to the sheet's visible edge the pointer must come to scroll it, and by how much
    property <length> edge-zone: 32px;
    property <length> edge-step: 16px;

    pure function column-width(c: int) -> length {
        if (c == root.dragged-column) {
            return root.drag-width;
        }
        if (Gradebook.columns[c].width > 0) {
            return Gradebook.columns[c].width * 1px;
        }
        return Gradebook.columns[c].kind == ColumnType.first-name ? ColumnWidths.first-name-default
            : Gradebook.columns[c].kind == ColumnType.surname ? ColumnWidths.surname-default
            : Gradebook.columns[c].kind == ColumnType.info ? ColumnWidths.wide-default
            : ColumnWidths.cell-default;
    }

    public function focus-new-pupil() {
        root.first-name-wanted = true;
    }

    // The add row's surname field: adds the pupil with both names, then empties both fields and
    // goes back to the first name for the next pupil. Refused (no first name), the surname stays
    // and the first name is where to type.
    function add-pupil() {
        if (Gradebook.add-new-pupil(root.new-first-name, root.new-surname)) {
            root.new-first-name = "";
            root.new-surname = "";
        }
        root.first-name-wanted = true;
    }

    // Follows a dragged header: scrolls the sheet near its visible edges and takes the first or
    // last gap past either end of the headers (the headers in between claim theirs).
    function drag-header(x: length) {
        root.move-x = x;
        let shown = x + sheet-view.content-x;
        if (shown < root.edge-zone) {
            sheet-view.content-x = min(0px, sheet-view.content-x + root.edge-step);
        } else if (shown > sheet-view.width - root.edge-zone) {
            sheet-view.content-x = max(min(0px, sheet-view.width - sheet-view.content-width), sheet-view.content-x - root.edge-step);
        }
        if (x < ColumnWidths.row-strip + 1px) {
            root.drop-gap = 0;
            root.drop-x = ColumnWidths.row-strip;
        } else if (x >= header-row.preferred-width) {
            root.drop-gap = Gradebook.columns.length;
            root.drop-x = header-row.preferred-width - 1px;
        }
    }

    // Drops the dragged column at the chosen gap; the gaps on either side of it leave it where it is
    // and write nothing.
    function drop-header(c: int) {
        let gap = root.drop-gap;
        root.moving-column = -1;
        root.drop-gap = -1;
        if (gap < 0 || gap == c || gap == c + 1) {
            return;
        }
        root.moved-column-id = Gradebook.columns[c].id;
        // the column is taken out first, so a gap to its right is one place further left
        Gradebook.move-column-to(Gradebook.columns[c].id, gap > c ? gap - 1 : gap);
    }

    // Scrolls the sheet sideways just enough for the column at `x` (in the grid) of `width` to be
    // whole on screen, left of the column panel where the panel covers the sheet; a column already
    // in view doesn't move it. A field taking focus is scrolled into view by Slint, but only its
    // text, which sits inside the cell's padding: the cells call this too, so their edges show.
    function reveal(x: length, width: length) {
        let covered = max(0px, sheet-view.absolute-position.x + sheet-view.width - root.panel-left);
        let room = max(0px, sheet-view.width - covered);
        let left = -sheet-view.content-x;
        let target = x < left ? x : x + width > left + room ? x + width - room : left;
        sheet-view.content-x = -max(0px, min(target, sheet-view.content-width - sheet-view.width));
    }

    // its natural size is the whole grid; it shrinks (and scrolls) when the window is smaller
    preferred-width: grid-lines.width + 2px;
    preferred-height: grid-lines.height + 2px;
    min-width: min(grid-lines.width + 2px, 320px);
    min-height: min(grid-lines.height + 2px, 180px);
    max-width: grid-lines.width + 2px;
    max-height: grid-lines.height + 2px;
    background: Theme.surface;
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.shadow;
    clip: true;
    sheet-view := ScrollView {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        content-width: grid-lines.width;
        content-height: grid-lines.height;
        grid-lines := Rectangle {
            x: 0px;
            y: 0px;
            width: grid.preferred-width;
            height: grid.preferred-height;
            background: Theme.line;
            grid := VerticalLayout {
                spacing: 1px;
                header-row := HorizontalLayout {
                    spacing: 1px;
                    Rectangle {
                        width: ColumnWidths.row-strip;
                        min-height: Theme.row-height;
                        background: Theme.raised;
                    }
                    for column[c] in Gradebook.columns: ColumnHeader {
                        width: root.column-width(c);
                        column: column;
                        index: c;
                        resizing(width) => {
                            root.drag-width = width;
                            root.dragged-column = c;
                        }
                        resized(width) => {
                            Gradebook.set-column-width(c, round(width / 1px));
                            root.dragged-column = -1;
                        }
                        reset-width => {
                            root.dragged-column = -1;
                            Gradebook.set-column-width(c, 0);
                        }
                        drag-started => {
                            root.moving-column = c;
                            root.drop-gap = -1;
                        }
                        drag-moved(x) => { root.drag-header(self.x + x); }
                        drag-ended => { root.drop-header(c); }
                        drag-cancelled => {
                            root.moving-column = -1;
                            root.drop-gap = -1;
                        }
                        // while a header is dragged over this one, the gap at its nearer side
                        property <int> claimed-gap: root.moving-column < 0 || root.move-x < self.x - 1px || root.move-x >= self.x + self.width ? -1
                            : root.move-x < self.x + self.width / 2 ? c : c + 1;
                        changed claimed-gap => {
                            if (self.claimed-gap >= 0) {
                                root.drop-gap = self.claimed-gap;
                                // on the grid line before or after this header
                                root.drop-x = self.claimed-gap == c ? self.x - 1px : self.x + self.width;
                            }
                        }
                        // the column whose settings the panel shows is kept in view, also
                        // when the panel steps to it or moves it (headers are rebuilt then)
                        property <bool> shown-in-panel: c == Gradebook.panel-index;
                        init => {
                            if (self.shown-in-panel || column.id == root.moved-column-id) {
                                root.reveal(self.x, self.width);
                            }
                            if (column.id == root.moved-column-id) {
                                root.moved-column-id = -1;
                            }
                        }
                        changed shown-in-panel => {
                            if (self.shown-in-panel) {
                                root.reveal(self.x, self.width);
                            }
                        }
                        // resizing the column the panel shows keeps it in view
                        changed width => {
                            if (self.shown-in-panel) {
                                root.reveal(self.x, self.width);
                            }
                        }
                    }
                }
                for row[r] in Gradebook.rows: HorizontalLayout {
                    spacing: 1px;
                    strip := Rectangle {
                        width: ColumnWidths.row-strip;
                        height: Theme.row-height;
                        background: Theme.surface;
                        IconButton {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            glyph: "×";
                            tooltip: @tr("Remove from this class");
                            destructive: true;
                            clicked => { Gradebook.remove-pupil(row.pupil-id); }
                        }
                    }
                    for cell[c] in row.cells: slot := Rectangle {
                        width: root.column-width(c);
                        height: Theme.row-height;
                        if Gradebook.columns[c].kind == ColumnType.first-name: NameCell {
                            width: parent.width;
                            pupil: row;
                            changed has-focus => {
                                if (self.has-focus) {
                                    // the remove button at the row's start comes into view too
                                    // when the first name is the first column
                                    root.reveal(c == 0 ? 0px : slot.x, c == 0 ? slot.x + slot.width : slot.width);
                                }
                            }
                        }
                        if Gradebook.columns[c].kind == ColumnType.surname: SurnameCell {
                            width: parent.width;
                            pupil: row;
                            changed has-focus => {
                                if (self.has-focus) {
                                    root.reveal(slot.x, slot.width);
                                }
                            }
                        }
                        if Gradebook.columns[c].kind != ColumnType.first-name && Gradebook.columns[c].kind != ColumnType.surname: GridCell {
                            width: parent.width;
                            text: cell.text;
                            spoken-label: row.full-name + ", " + Gradebook.columns[c].title;
                            invalid: cell.invalid;
                            tone: cell.tone;
                            provisional: cell.provisional;
                            computed: Gradebook.columns[c].kind != ColumnType.info && Gradebook.columns[c].kind != ColumnType.test;
                            numeric: Gradebook.columns[c].kind != ColumnType.info;
                            edited(text) => { Gradebook.cell-edited(r, c, text); }
                            changed has-focus => {
                                if (self.has-focus) {
                                    root.reveal(slot.x, slot.width);
                                }
                            }
                            // Enter goes down the same column, which is typed in every row, so it
                            // never lands on a calculated or name cell; after the last pupil it
                            // leaves the sheet
                            property <bool> requested: root.focus-row == r && root.focus-column == c;
                            changed requested => {
                                if (self.requested) {
                                    self.focus-and-select();
                                    root.focus-row = -1;
                                    root.focus-column = -1;
                                }
                            }
                            next => {
                                if (r + 1 < Gradebook.rows.length) {
                                    root.focus-column = c;
                                    root.focus-row = r + 1;
                                } else {
                                    self.leave();
                                }
                            }
                        }
                    }
                }
                // The add row: a field under each name column, empty cells elsewhere. Each cell
                // takes the 1px grid line after it too, so no lines show through this row.
                HorizontalLayout {
                    Rectangle {
                        width: ColumnWidths.row-strip + 1px;
                        height: Theme.row-height;
                        background: Theme.surface;
                        Text {
                            width: ColumnWidths.row-strip;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            text: "+";
                            font-size: Theme.text-l;
                            color: root.first-name-focused || root.surname-focused ? Theme.accent : Theme.faint;
                        }
                    }
                    for column[c] in Gradebook.columns: add-slot := Rectangle {
                        width: root.column-width(c) + 1px;
                        height: Theme.row-height;
                        background: Theme.surface;
                        if column.kind == ColumnType.first-name: TextField {
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                            width: parent.width - 21px;
                            boxed: false;
                            placeholder: @tr("First name…");
                            text <=> root.new-first-name;
                            property <bool> wanted: root.first-name-wanted;
                            function take-focus() {
                                if (root.first-name-wanted) {
                                    root.first-name-wanted = false;
                                    self.focus-input();
                                }
                            }
                            init => { self.take-focus(); }
                            changed wanted => { self.take-focus(); }
                            changed has-focus => {
                                root.first-name-focused = self.has-focus;
                                if (self.has-focus) {
                                    // the "+" at the row's start comes into view too when this is the first column
                                    root.reveal(c == 0 ? 0px : add-slot.x, c == 0 ? add-slot.x + add-slot.width : add-slot.width);
                                }
                            }
                            // the surname comes next; Enter there adds the pupil
                            accepted => { root.surname-wanted = true; }
                        }
                        if column.kind == ColumnType.surname: TextField {
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                            width: parent.width - 21px;
                            boxed: false;
                            placeholder: @tr("Surname…");
                            text <=> root.new-surname;
                            property <bool> wanted: root.surname-wanted;
                            function take-focus() {
                                if (root.surname-wanted) {
                                    root.surname-wanted = false;
                                    self.focus-input();
                                }
                            }
                            init => { self.take-focus(); }
                            changed wanted => { self.take-focus(); }
                            changed has-focus => {
                                root.surname-focused = self.has-focus;
                                if (self.has-focus) {
                                    root.reveal(add-slot.x, add-slot.width);
                                }
                            }
                            accepted => { root.add-pupil(); }
                        }
                    }
                    // fills the rest of the last row so no grid lines show through
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.surface;
                    }
                }
            }
            // where a dragged header will land, across the whole grid
            if root.moving-column >= 0 && root.drop-gap >= 0: Rectangle {
                x: root.drop-x - 0.5px;
                y: 0px;
                width: 2px;
                height: grid-lines.height;
                background: Theme.accent;
            }
        }
    }
}
