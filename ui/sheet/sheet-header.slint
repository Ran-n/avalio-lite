import { Theme } from "../theme.slint";
import { Gradebook } from "../gradebook.slint";
import { ActionButton, ButtonKind, IconActionButton } from "../components/buttons.slint";
import { TextField } from "../components/fields.slint";
import { IconKind } from "../components/icons.slint";

component Summary inherits VerticalLayout {
    spacing: 4px;
    HorizontalLayout {
        spacing: 22px;
        alignment: start;
        Text {
            text: @tr("{n} pupil" | "{n} pupils" % Gradebook.rows.length);
            color: Theme.muted;
        }
        if Gradebook.has-summary: Text {
            text: @tr("Class average {}", Gradebook.class-average);
            color: Theme.muted;
        }
        if Gradebook.has-summary: Text {
            text: @tr("{n} passing" | "{n} passing" % Gradebook.passing);
            color: Theme.pass;
            font-weight: 600;
        }
        if Gradebook.has-summary && Gradebook.failing > 0: Text {
            text: @tr("{n} failing" | "{n} failing" % Gradebook.failing);
            color: Theme.fail;
            font-weight: 600;
        }
    }
    if !Gradebook.weights-complete: Text {
        text: @tr("Test weights add up to {}%, not 100%", Gradebook.weight-total);
        color: Theme.warn;
    }
}

// The class name with the sheet's actions beside it, and the summary line underneath. The summary
// gets its own full-width line so the buttons always fit, even in Galician at the minimum width.
export component SheetTitle inherits VerticalLayout {
    callback add-pupil();
    callback add-column();
    callback more();
    out property <length> add-column-right: add-column-button.absolute-position.x + add-column-button.width;
    out property <length> more-right: more-button.absolute-position.x + more-button.width;
    out property <length> actions-bottom: add-column-button.absolute-position.y + add-column-button.height;

    spacing: 4px;
    HorizontalLayout {
        spacing: 16px;
        TextField {
            horizontal-stretch: 1;
            boxed: false;
            text: Gradebook.class-name;
            spoken-label: @tr("Class name");
            font-size: Theme.text-xl;
            font-weight: 600;
            restores: true;
            saved: Gradebook.class-name;
            restored => { Gradebook.field-restored(); }
            edited(text) => { Gradebook.rename-class(text); }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 8px;
                ActionButton {
                    text: @tr("+ Add pupil");
                    clicked => { root.add-pupil(); }
                }
                add-column-button := ActionButton {
                    text: @tr("+ Add column");
                    kind: ButtonKind.primary;
                    clicked => { root.add-column(); }
                }
                more-button := IconActionButton {
                    icon: IconKind.more;
                    label: @tr("More actions");
                    clicked => { root.more(); }
                }
            }
        }
    }
    Summary { }
}
