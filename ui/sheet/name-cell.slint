import { Theme } from "../theme.slint";
import { Gradebook, RowItem } from "../gradebook.slint";
import { TextField } from "../components/fields.slint";

// A pupil's first name, edited in place. A first name can't be emptied: a refused one is put back.
export component NameCell inherits Rectangle {
    in property <RowItem> pupil;
    // while the name is being edited, so the sheet can scroll the whole cell into view
    out property <bool> has-focus: name.has-focus;

    height: Theme.row-height;
    background: Theme.surface;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        VerticalLayout {
            alignment: center;
            name := TextField {
                boxed: false;
                text: root.pupil.first-name;
                spoken-label: @tr("First name");
                restores: true;
                saved: root.pupil.first-name;
                restored => { Gradebook.field-restored(); }
                edited(text) => { Gradebook.set-first-name(root.pupil.pupil-id, text); }
            }
        }
    }
}

// A pupil's surname, edited in place. It may be emptied, so nothing is ever put back.
export component SurnameCell inherits Rectangle {
    in property <RowItem> pupil;
    out property <bool> has-focus: surname.has-focus;

    height: Theme.row-height;
    background: Theme.surface;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        VerticalLayout {
            alignment: center;
            surname := TextField {
                boxed: false;
                text: root.pupil.surname;
                spoken-label: @tr("Surname");
                leaves-on-enter: true;
                edited(text) => { Gradebook.set-surname(root.pupil.pupil-id, text); }
            }
        }
    }
}
